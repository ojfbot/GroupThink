{
  "manifest_version": 3,
  "name": "GroupThink",
  "version": "0.1.0",
  "description": "LLM-powered tab grouping for AI-first browsers",
  "permissions": ["tabs", "storage", "activeTab", "debugger", "system.display"],
  "optional_permissions": ["history", "bookmarks", "topSites", "sessions", "tabGroups"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_page": "src/options/index.html",
  "commands": {
    "open-groupthink": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Command+Shift+K"
      },
      "description": "Open GroupThink tab view"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
